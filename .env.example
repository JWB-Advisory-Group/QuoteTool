NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional dashboard protection. If omitted, the dashboard is open in local/dev.
DASHBOARD_PIN=
CRON_SECRET=

# Optional vendor credentials. Without these, notifications are written to .data/notification-log.jsonl.
DANTE_EMAIL=
DANTE_PHONE=
RESEND_API_KEY=
RESEND_FROM="631 Solutions <quotes@631solutions.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Optional local persistence override.
LOCAL_DATA_PATH=

# Optional Nassau parcel query URL for the truth gate, if a public endpoint is validated later.
NASSAU_PARCEL_QUERY_URL=

# Stripe deposit collection (Dante's Stripe account — NOT a developer/platform account).
# From Stripe Dashboard → Developers → API keys. Use test keys (sk_test_/pk_test_) until ready.
# If STRIPE_SECRET_KEY is unset, deposit collection falls back silently to the manual hold flow.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From Stripe Dashboard → Developers → Webhooks → Add endpoint pointing at /api/webhooks/stripe.
# Required for automated `awaiting_deposit` → `scheduled` transition after the customer pays.
STRIPE_WEBHOOK_SECRET=
